{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build release APK",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"tool\\build_release_apk.bat"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Clean and build release APK",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"call \"%USERPROFILE%\\.vscode\\flutter\\bin\\flutter.bat\" clean && call tool\\build_release_apk.bat"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Rebuild release APK after Flutter config fix",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"tool\\build_release_apk.bat"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Write APK info",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"for %I in (\"C:\\Users\\obedi\\CropCareAI\\CropCareAI-release.apk\") do @echo %~fI && @echo %~zI && @echo %~tI > C:\\Users\\obedi\\CropCareAI\\.tmp\\apk_info.txt"
			],
			"isBackground": false
		},
		{
			"label": "Write Flutter version to file",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"\"C:\\Users\\obedi\\.vscode\\flutter\\bin\\flutter.bat\" --version > C:\\Users\\obedi\\CropCareAI\\.tmp\\flutter_version.txt 2>&1"
			],
			"isBackground": false
		},
		{
			"label": "Validate website Flutter SDK",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"\"C:\\Users\\obedi\\src\\flutter\\flutter\\bin\\flutter.bat\" --version > C:\\Users\\obedi\\CropCareAI\\.tmp\\flutter_version_new.txt 2>&1"
			],
			"isBackground": false
		},
		{
			"label": "Probe website Flutter version",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"\"C:\\Users\\obedi\\src\\flutter\\flutter\\bin\\flutter.bat\" --version > C:\\Users\\obedi\\CropCareAI\\.tmp\\website_flutter_version.txt 2>&1"
			],
			"isBackground": false
		},
		{
			"label": "Capture APK metadata",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"(for %I in (\"C:\\Users\\obedi\\CropCareAI\\CropCareAI-release.apk\") do @echo FullName=%~fI& @echo Length=%~zI& @echo LastWriteTime=%~tI) > \"C:\\Users\\obedi\\CropCareAI\\.tmp\\apk_info.txt\""
			],
			"isBackground": false
		},
		{
			"label": "Print APK metadata",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"for %I in (\"C:\\Users\\obedi\\CropCareAI\\CropCareAI-release.apk\") do @echo FullName=%~fI & @echo Length=%~zI & @echo LastWriteTime=%~tI"
			],
			"isBackground": false
		},
		{
			"label": "Check old Flutter SDK version",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"\"C:\\Users\\obedi\\.vscode\\flutter\\bin\\flutter.bat\" --version"
			],
			"isBackground": false
		},
		{
			"label": "Build APK with old Flutter SDK",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"\"C:\\Users\\obedi\\.vscode\\flutter\\bin\\flutter.bat\" build apk --release --dart-define=AI_BACKEND_BASE_URL=https://cropcareai-nxn4.onrender.com && copy /y \"build\\app\\outputs\\flutter-apk\\app-release.apk\" \"CropCareAI-release.apk\" >nul && del /f /q \"build\\app\\outputs\\flutter-apk\\app-release.apk\" >nul 2>nul && del /f /q \"build\\app\\outputs\\flutter-apk\\app-release.apk.sha1\" >nul 2>nul"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Rebuild APK with old Flutter SDK",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"\"C:\\Users\\obedi\\.vscode\\flutter\\bin\\flutter.bat\" build apk --release --dart-define=AI_BACKEND_BASE_URL=https://cropcareai-nxn4.onrender.com && copy /y \"build\\app\\outputs\\flutter-apk\\app-release.apk\" \"CropCareAI-release.apk\" >nul && del /f /q \"build\\app\\outputs\\flutter-apk\\app-release.apk\" >nul 2>nul && del /f /q \"build\\app\\outputs\\flutter-apk\\app-release.apk.sha1\" >nul 2>nul"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Print rebuilt APK metadata",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"for %I in (\"C:\\Users\\obedi\\CropCareAI\\CropCareAI-release.apk\") do @echo FullName=%~fI & @echo Length=%~zI & @echo LastWriteTime=%~tI"
			],
			"isBackground": false
		},
		{
			"label": "Inspect release git status",
			"type": "shell",
			"command": "git status --short --branch",
			"isBackground": false,
			"problemMatcher": []
		}
	]
}